# OpenAI-compatible endpoint. Any silicon-conductor-bench .env file also works via --env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=
OPENAI_MAX_TOKENS=32768
OPENAI_TIMEOUT_MS=600000
# Send reasoning_content back inside the same cycle (DeepSeek thinking + tool calls).
OPENAI_REPLAY_REASONING_CONTENT=true
# Optional
OPENAI_THINKING=
OPENAI_REASONING_EFFORT=
OPENAI_TEMPERATURE=
